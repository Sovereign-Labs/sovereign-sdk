{
  "permissions": {
    "allow": [
      "Bash(make lint:*)",
      "Bash(make test:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo nextest run:*)",
      "Bash(cargo test:*)",
      "Bash(cargo build:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo check:*)",
      "Bash(cargo fmt:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue view:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "FILE_PATH=$(jq -r '.tool_input.file_path // empty'); if [[ \"$FILE_PATH\" == *.rs ]]; then cargo +nightly fmt --all --quiet 2>/dev/null || true; fi"
          }
        ]
      }
    ]
  }
}
