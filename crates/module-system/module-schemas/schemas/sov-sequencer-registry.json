{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CallMessage",
  "description": "This enumeration represents the available call messages for interacting with\nthe `sov-sequencer-registry` module.",
  "oneOf": [
    {
      "description": "Add a new sequencer to the sequencer registry.",
      "type": "object",
      "properties": {
        "register": {
          "type": "object",
          "properties": {
            "amount": {
              "description": "The initial balance of the sequencer.",
              "$ref": "#/$defs/Amount"
            },
            "da_address": {
              "description": "The Da address of the sequencer you're registering.",
              "$ref": "#/$defs/MockAddress"
            }
          },
          "required": [
            "da_address",
            "amount"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "register"
      ]
    },
    {
      "description": "Increases the balance of the sequencer, transferring the funds from the sequencer account\nto the rollup.",
      "type": "object",
      "properties": {
        "deposit": {
          "type": "object",
          "properties": {
            "amount": {
              "description": "The amount to increase.",
              "$ref": "#/$defs/Amount"
            },
            "da_address": {
              "description": "The DA address of the sequencer.",
              "$ref": "#/$defs/MockAddress"
            }
          },
          "required": [
            "da_address",
            "amount"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "deposit"
      ]
    },
    {
      "description": "Initiate a withdrawal of a sequencer's balance.",
      "type": "object",
      "properties": {
        "initiate_withdrawal": {
          "type": "object",
          "properties": {
            "da_address": {
              "description": "The DA address of the sequencer you're removing.",
              "$ref": "#/$defs/MockAddress"
            }
          },
          "required": [
            "da_address"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "initiate_withdrawal"
      ]
    },
    {
      "description": "Withdraw a sequencer's balance after waiting for the withdrawal period.",
      "type": "object",
      "properties": {
        "withdraw": {
          "type": "object",
          "properties": {
            "da_address": {
              "description": "The DA address of the sequencer you're removing.",
              "$ref": "#/$defs/MockAddress"
            }
          },
          "required": [
            "da_address"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "withdraw"
      ]
    }
  ],
  "$defs": {
    "Amount": {
      "description": "A token amount.",
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "MockAddress": {
      "description": "Mock address; 32 bytes in hex-encoded format",
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    }
  }
}
