{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CallMessage",
  "description": "This enumeration represents the available call messages for interacting with the `ExampleModule` module.",
  "oneOf": [
    {
      "description": "Add a new prover as a bonded prover.",
      "type": "object",
      "properties": {
        "register": {
          "$ref": "#/$defs/Amount"
        }
      },
      "additionalProperties": false,
      "required": [
        "register"
      ]
    },
    {
      "description": "Increases the balance of the prover, transferring the funds from the prover account\nto the rollup.",
      "type": "object",
      "properties": {
        "deposit": {
          "$ref": "#/$defs/Amount"
        }
      },
      "additionalProperties": false,
      "required": [
        "deposit"
      ]
    },
    {
      "description": "Unbonds the prover.",
      "type": "string",
      "const": "exit"
    }
  ],
  "$defs": {
    "Amount": {
      "description": "A token amount.",
      "type": "string",
      "pattern": "^[0-9]+$"
    }
  }
}
