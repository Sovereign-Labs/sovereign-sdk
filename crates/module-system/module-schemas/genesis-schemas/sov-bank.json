{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BankConfig",
  "description": "Initial configuration for sov-bank module.",
  "type": "object",
  "properties": {
    "gas_token_config": {
      "description": "Configuration for the gas token",
      "anyOf": [
        {
          "$ref": "#/$defs/GasTokenConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tokens": {
      "description": "A list of configurations for any other tokens to create at genesis",
      "type": "array",
      "items": {
        "$ref": "#/$defs/TokenConfig"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "tokens"
  ],
  "$defs": {
    "Address": {
      "description": "Address",
      "type": "string",
      "pattern": "^sov1[a-zA-Z0-9]+$"
    },
    "Amount": {
      "description": "A token amount.",
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "GasTokenConfig": {
      "description": "[`GasTokenConfig`] specifies a configuration for the rollup's gas token.",
      "type": "object",
      "properties": {
        "address_and_balances": {
          "description": "A vector of tuples containing the initial addresses and balances (as u128)",
          "type": "array",
          "items": {
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "$ref": "#/$defs/Address"
              },
              {
                "$ref": "#/$defs/Amount"
              }
            ]
          }
        },
        "admins": {
          "description": "The addresses that are authorized to mint the token.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Address"
          }
        },
        "supply_cap": {
          "description": "Supply cap of the token. If None, the value falls back to Amount::MAX.",
          "anyOf": [
            {
              "$ref": "#/$defs/Amount"
            },
            {
              "type": "null"
            }
          ]
        },
        "token_decimals": {
          "description": "The decimal places of the token.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "token_name": {
          "description": "The name of the token.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "token_name",
        "address_and_balances",
        "admins"
      ]
    },
    "TokenConfig": {
      "description": "[`TokenConfig`] specifies a configuration used when generating a token for the bank\nmodule.",
      "type": "object",
      "properties": {
        "address_and_balances": {
          "description": "A vector of tuples containing the initial addresses and balances (as u128)",
          "type": "array",
          "items": {
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "$ref": "#/$defs/Address"
              },
              {
                "$ref": "#/$defs/Amount"
              }
            ]
          }
        },
        "admins": {
          "description": "The addresses that are authorized to mint the token.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Address"
          }
        },
        "supply_cap": {
          "description": "Supply cap of the token. If None, the value falls back to Amount::MAX.",
          "anyOf": [
            {
              "$ref": "#/$defs/Amount"
            },
            {
              "type": "null"
            }
          ]
        },
        "token_decimals": {
          "description": "The decimal places of the token.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "token_id": {
          "description": "Predetermined ID of the token. Allowed only for genesis tokens.",
          "$ref": "#/$defs/TokenId"
        },
        "token_name": {
          "description": "The name of the token.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "token_name",
        "token_id",
        "address_and_balances",
        "admins"
      ]
    },
    "TokenId": {
      "description": "A bech32 string",
      "type": "string",
      "pattern": "^token_1[a-zA-Z0-9]+$"
    }
  }
}
