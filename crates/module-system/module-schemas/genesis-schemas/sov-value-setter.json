{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ValueSetterConfig",
  "description": "Initial configuration for sov-value-setter module.",
  "type": "object",
  "properties": {
    "admin": {
      "description": "Admin of the module.",
      "$ref": "#/$defs/Address"
    }
  },
  "additionalProperties": false,
  "required": [
    "admin"
  ],
  "$defs": {
    "Address": {
      "description": "Address",
      "type": "string",
      "pattern": "^sov1[a-zA-Z0-9]+$"
    }
  }
}
