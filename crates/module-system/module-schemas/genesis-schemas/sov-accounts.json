{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AccountConfig",
  "description": "Initial configuration for sov-accounts module.",
  "type": "object",
  "properties": {
    "accounts": {
      "description": "Accounts to initialize the rollup.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/AccountData"
      }
    },
    "enable_custom_account_mappings": {
      "description": "Enable custom `CredentailId` => `Account` mapping.",
      "type": "boolean",
      "default": true
    }
  },
  "additionalProperties": false,
  "required": [
    "accounts"
  ],
  "$defs": {
    "AccountData": {
      "description": "Account data for the genesis.",
      "type": "object",
      "properties": {
        "address": {
          "description": "Address of the account.",
          "$ref": "#/$defs/Address"
        },
        "credential_id": {
          "description": "Credential ID of the account.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "credential_id",
        "address"
      ]
    },
    "Address": {
      "description": "Address",
      "type": "string",
      "pattern": "^sov1[a-zA-Z0-9]+$"
    }
  }
}
