{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AccountConfig",
  "description": "Initial configuration for sov-accounts module.",
  "type": "object",
  "properties": {
    "accounts": {
      "description": "Credential/address authorizations to initialize.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/AccountData"
      }
    },
    "enable_custom_account_mappings": {
      "description": "Enable configured credential authorizations and `InsertCredentialId`.",
      "default": true,
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "AccountData_for_Address": {
      "description": "Credential/address authorization data for genesis.",
      "type": "object",
      "properties": {
        "address": {
          "description": "Address the credential may act as.",
          "allOf": [
            {
              "$ref": "#/$defs/Address"
            }
          ]
        },
        "credential_id": {
          "description": "Credential ID to authorize.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "credential_id",
        "address"
      ]
    },
    "Address": {
      "description": "Address",
      "type": "string",
      "pattern": "^sov1[a-zA-Z0-9]+$"
    }
  }
}
