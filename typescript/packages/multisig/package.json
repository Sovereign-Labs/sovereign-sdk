{
  "name": "@sovereign-sdk/multisig",
  "version": "0.3.1",
  "description": "Multisig functionality for Sovereign SDK applications",
  "scripts": {
    "build": "tsup",
    "ci": "biome ci",
    "fix": "biome check --write",
    "lint": "biome lint",
    "test": "vitest run **/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sovereign-Labs/sovereign-sdk.git"
  },
  "files": ["dist", "README.md", "package.json"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "devDependencies": {
    "@sovereign-sdk/types": "workspace:^",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "4.0.7"
  },
  "peerDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noble/hashes": "^1.5.0",
    "@sovereign-sdk/utils": "workspace:^",
    "borsh": "0.7.0"
  }
}
