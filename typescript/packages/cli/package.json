{
  "name": "@sovereign-sdk/cli",
  "version": "0.1.0",
  "description": "CLI utilities for Sovereign SDK",
  "scripts": {
    "build": "pnpm typecheck && tsup",
    "ci": "biome ci",
    "fix": "biome check --write",
    "lint": "biome lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "repository": "github:Sovereign-Labs/sovereign-sdk",
  "files": ["dist", "README.md", "package.json"],
  "bin": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "4.0.7"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "smol-toml": "^1.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
