prefix_rule(pattern=["cargo", "nextest", "run"], decision="allow")
prefix_rule(pattern=["env", "SKIP_GUEST_BUILD=1", "cargo", "nextest", "run"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "SKIP_GUEST_BUILD=1 cargo nextest run"], decision="allow")
prefix_rule(pattern=["cargo", "check"], decision="allow")
prefix_rule(pattern=["env", "SKIP_GUEST_BUILD=1", "cargo", "check"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "SKIP_GUEST_BUILD=1 cargo check"], decision="allow")
prefix_rule(pattern=["cargo", "clippy"], decision="allow")
prefix_rule(pattern=["env", "SKIP_GUEST_BUILD=1", "cargo", "clippy"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "SKIP_GUEST_BUILD=1 cargo clippy"], decision="allow")
prefix_rule(pattern=["cargo", "fmt"], decision="allow")
prefix_rule(pattern=["cargo", "+nightly", "fmt"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "cargo fmt"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "cargo +nightly fmt"], decision="allow")
prefix_rule(pattern=["gh", "pr", "view"], decision="allow")
prefix_rule(pattern=["gh", "issue", "view"], decision="allow")
prefix_rule(pattern=["gh", "run", "view"], decision="allow")
